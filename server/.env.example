# ─────────────────────────────────────────────────────────────────────────────
# Help Desk Pro — Server Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# Add .env to .gitignore (it already is — see root .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────

# Set to "production" on Vercel / cloud hosts. Leave "development" locally.
NODE_ENV=development

# Port the Express server listens on locally (Vercel ignores this).
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Encode special characters in the password with percent-encoding,
#   e.g. @ → %40, # → %23
# Leave blank to run in in-memory demo mode (no persistence).
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/helpdesk

# ── JWT ──────────────────────────────────────────────────────────────────────

# Secret used to sign and verify JSON Web Tokens.
# Generate a strong random value (minimum 64 characters):
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_secret_minimum_64_characters

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────

# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application

# The client ID shown on the OAuth 2.0 credentials page.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# The client secret shown on the OAuth 2.0 credentials page.
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# The URI Google will redirect to after the user authenticates.
# Must be added to "Authorised redirect URIs" in Google Cloud Console exactly as written.
# Local dev:   http://localhost:4000/api/auth/google/callback
# Production:  https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Frontend ─────────────────────────────────────────────────────────────────

# The URL of the React frontend. Used for:
#   1. CORS — only this origin is allowed in production.
#   2. OAuth redirect — users are sent here after Google sign-in.
# Local dev:   http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ── Domain restriction (optional) ────────────────────────────────────────────

# If set, Google OAuth sign-in is restricted to email addresses ending with
# this domain. Leave blank (or remove the line) to allow any Google account.
#
# Example — only allow company employees:
#   ALLOWED_EMAIL_DOMAIN=company.com
ALLOWED_EMAIL_DOMAIN=
