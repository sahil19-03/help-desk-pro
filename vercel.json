{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "cd client && npx vite build --outDir ../dist --emptyOutDir",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
